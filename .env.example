# Адрес сайта — нужен для canonical, OG-картинки и sitemap.
NEXT_PUBLIC_SITE_URL=https://kvarta-minsk.vercel.app

# Где хранить заявки: sqlite (по умолчанию) | redis | file | memory.
# Ничего не указывать — приложение само выберет SQLite, а на serverless уйдёт в файл.
# LEAD_STORE=sqlite
# LEAD_DB_PATH=./data/leads.sqlite
# LEAD_FILE_PATH=/tmp/kvarta-leads.jsonl

# Redis для нескольких инстансов (Upstash, бесплатный тариф).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Соль для хеша IP: сам адрес не храним, только хеш.
LEAD_IP_SALT=придумайте-свою-соль

# Необязательно: дублировать заявку в Telegram-бот.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
